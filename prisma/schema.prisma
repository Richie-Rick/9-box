generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  EMPLOYEE
  MANAGER
  AREA_LEAD
  LEADERSHIP
  ADMIN
}

enum CycleStatus {
  OPEN
  CLOSED
}

enum TrendDirection {
  IMPROVING
  STABLE
  DECLINING
}

enum GoalStatus {
  PROPOSED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum GoalUpdateStatus {
  ON_TRACK
  OFF_TRACK
  DONE
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  jobTitle     String?
  team         String?
  role         Role     @default(EMPLOYEE)
  managerId    String?
  manager      User?    @relation("ManagerReports", fields: [managerId], references: [id])
  reports      User[]   @relation("ManagerReports")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  managerAssessmentsGiven    ManagerAssessment[] @relation("AssessmentByManager")
  managerAssessmentsReceived ManagerAssessment[] @relation("AssessmentForEmployee")
  selfAssessments            SelfAssessment[]
  resources                  Resource[]
  goals                      Goal[]             @relation("EmployeeGoals")
  goalsCreated               Goal[]             @relation("GoalCreator")
  goalsProposed              Goal[]             @relation("GoalProposer")
  goalUpdates                GoalUpdate[]
  revisionsMade              AssessmentRevision[] @relation("RevisionAuthor")
  keyMetrics                 KeyMetric[]        @relation("EmployeeKeyMetrics")
  keyMetricsCreated          KeyMetric[]        @relation("KeyMetricCreator")

  @@index([managerId])
  @@index([role])
}

model Invitation {
  id        String   @id @default(cuid())
  email     String
  name      String
  jobTitle  String?
  team      String?
  role      Role     @default(EMPLOYEE)
  managerId String?
  token     String   @unique
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([token])
  @@index([email])
}

model AssessmentCycle {
  id        String      @id @default(cuid())
  month     Int
  year      Int
  status    CycleStatus @default(OPEN)
  createdAt DateTime    @default(now())

  managerAssessments ManagerAssessment[]
  selfAssessments    SelfAssessment[]
  goalUpdates        GoalUpdate[]

  @@unique([month, year])
}

model ManagerAssessment {
  id                  String    @id @default(cuid())
  cycleId             String
  cycle               AssessmentCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  managerId           String
  manager             User      @relation("AssessmentByManager", fields: [managerId], references: [id], onDelete: Cascade)
  employeeId          String
  employee            User      @relation("AssessmentForEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  performance         Int?
  performanceEvidence String?
  growthReadiness          Int?
  growthReadinessEvidence  String?
  valCustomerFirst    Int?
  valStepIntoArena    Int?
  valFlockToProblems  Int?
  valGiveEnergy       Int?
  valuesEvidence      String?
  engagement          Int?
  engagementEvidence  String?
  achievementsObserved String?
  blockersToRemove    String?
  supportCommitted    String?
  responsePerformance String?
  responseGrowth      String?
  responseValues      String?
  responseEngagement  String?
  initialRatings      Json?
  trend               TrendDirection?
  notes               String?
  submittedAt         DateTime?
  sharedAt            DateTime?
  finalisedAt         DateTime?
  oneOnOneComplete    Boolean   @default(false)
  oneOnOneCompletedAt DateTime?
  oneOnOneNotes       String?
  editCount           Int       @default(0)
  lastEditedAt        DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  revisions           AssessmentRevision[]
  agreedActions       AgreedAction[]

  @@unique([cycleId, managerId, employeeId])
  @@index([cycleId])
  @@index([managerId])
  @@index([employeeId])
}

model AssessmentRevision {
  id                  String            @id @default(cuid())
  managerAssessmentId String
  managerAssessment   ManagerAssessment @relation(fields: [managerAssessmentId], references: [id], onDelete: Cascade)
  changedById         String
  changedBy           User              @relation("RevisionAuthor", fields: [changedById], references: [id], onDelete: Cascade)
  changedAt           DateTime          @default(now())
  reason              String?
  before              Json
  after               Json

  @@index([managerAssessmentId])
}

model AgreedAction {
  id                  String            @id @default(cuid())
  managerAssessmentId String
  managerAssessment   ManagerAssessment @relation(fields: [managerAssessmentId], references: [id], onDelete: Cascade)
  text                String
  done                Boolean           @default(false)
  goalId              String?
  goal                Goal?             @relation(fields: [goalId], references: [id], onDelete: SetNull)
  sortOrder           Int               @default(0)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@index([managerAssessmentId])
}

model SelfAssessment {
  id                       String    @id @default(cuid())
  cycleId                  String
  cycle                    AssessmentCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  employeeId               String
  employee                 User      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  performance              Int?
  performanceJustification String?
  achievements             String?
  blockers                 String?
  learning                 String?
  growthReadiness          Int?
  growthReflection         String?
  valCustomerFirst         Int?
  valStepIntoArena         Int?
  valFlockToProblems       Int?
  valGiveEnergy            Int?
  valuesReflection         String?
  engagement               Int?
  engagementDriver         String?
  supportNeeded            String?
  goalsNextMonth           String?
  submittedAt              DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  @@unique([cycleId, employeeId])
  @@index([cycleId])
  @@index([employeeId])
}

model Resource {
  id           String   @id @default(cuid())
  title        String
  slug         String   @unique
  content      String
  published    Boolean  @default(false)
  sortOrder    Int      @default(0)
  allowedRoles Role[]   @default([EMPLOYEE, MANAGER, AREA_LEAD, LEADERSHIP, ADMIN])
  createdById  String
  createdBy    User     @relation(fields: [createdById], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([slug])
  @@index([published])
}

model Goal {
  id          String     @id @default(cuid())
  employeeId  String
  employee    User       @relation("EmployeeGoals", fields: [employeeId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User       @relation("GoalCreator", fields: [createdById], references: [id])
  proposedById String?
  proposedBy  User?      @relation("GoalProposer", fields: [proposedById], references: [id])
  title       String
  description String?
  dueDate     DateTime?
  status      GoalStatus @default(ACTIVE)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  updates     GoalUpdate[]
  agreedActions AgreedAction[]

  @@index([employeeId])
  @@index([createdById])
}

model GoalUpdate {
  id        String           @id @default(cuid())
  goalId    String
  goal      Goal             @relation(fields: [goalId], references: [id], onDelete: Cascade)
  cycleId   String
  cycle     AssessmentCycle  @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  authorId  String
  author    User             @relation(fields: [authorId], references: [id], onDelete: Cascade)
  status    GoalUpdateStatus
  note      String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([goalId, cycleId, authorId])
  @@index([cycleId])
}

model KeyMetric {
  id          String  @id @default(cuid())
  employeeId  String
  employee    User    @relation("EmployeeKeyMetrics", fields: [employeeId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User    @relation("KeyMetricCreator", fields: [createdById], references: [id])
  name        String
  target      String
  unit        String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([employeeId])
  @@index([createdById])
}
